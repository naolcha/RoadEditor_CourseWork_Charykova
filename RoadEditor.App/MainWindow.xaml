<Window x:Class="RoadEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Road Editor"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#111118"
        PreviewKeyDown="Window_PreviewKeyDown"
        Focusable="True">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="34"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Menu Grid.Row="0"
              Background="#15151d"
              Foreground="White"
              FontSize="14">
			<MenuItem Header="Очистить" Click="ClearMap_Click"/>
			<MenuItem Header="Залить" Click="FillMap_Click"/>
			<MenuItem Header="Справка" Click="Help_Click"/>
		</Menu>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="320"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0"
                    Background="#2d0054"
                    Padding="14">

				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>

						<TextBlock Text="Редактор дорог"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,0,0,18"/>

						<TextBlock x:Name="CellInfoText"
                                   Text="Номер ячейки: 0, 0"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,18"/>

						<TextBlock Text="Размер карты"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

						<Grid Margin="0,0,0,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0" Margin="0,0,6,0">
								<TextBlock Text="Ширина" Foreground="White"/>
								<TextBox x:Name="MapWidthTextBox"
                                         Text="12"
                                         Height="30"
                                         FontSize="16"/>
							</StackPanel>

							<StackPanel Grid.Column="1" Margin="6,0,0,0">
								<TextBlock Text="Высота" Foreground="White"/>
								<TextBox x:Name="MapHeightTextBox"
                                         Text="7"
                                         Height="30"
                                         FontSize="16"/>
							</StackPanel>
						</Grid>

						<Button Content="Создать карту"
                                Height="36"
                                FontSize="15"
                                Foreground="White"
                                Background="#416a9e"
                                BorderBrush="#00aeff"
                                BorderThickness="1.5"
                                Margin="0,0,0,20"
                                Click="CreateMap_Click"/>

						<TextBlock Text="Текущий элемент"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

						<Canvas x:Name="SelectedTilePreview"
                                Width="120"
                                Height="120"
                                Background="#111118"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20"/>

						<TextBlock Text="Дорожные элементы"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

						<UniformGrid Columns="2">
							<Button Content="Пусто"
                                    Tag="Empty"
                                    Click="TileButton_Click"
                                    Margin="3"
                                    Foreground="White"
                                    Background="#416a9e"
                                    BorderBrush="#00aeff"/>

							<Button Content="Горизонт."
                                    Tag="RoadHorizontal"
                                    Click="TileButton_Click"
                                    Margin="3"
                                    Foreground="White"
                                    Background="#416a9e"
                                    BorderBrush="#00aeff"/>

							<Button Content="Вертик."
                                    Tag="RoadVertical"
                                    Click="TileButton_Click"
                                    Margin="3"
                                    Foreground="White"
                                    Background="#416a9e"
                                    BorderBrush="#00aeff"/>

							<Button Content="Угол 1"
                                    Tag="CornerRightDown"
                                    Click="TileButton_Click"
                                    Margin="3"
                                    Foreground="White"
                                    Background="#416a9e"
                                    BorderBrush="#00aeff"/>

							<Button Content="Угол 2"
                                    Tag="CornerLeftDown"
                                    Click="TileButton_Click"
                                    Margin="3"
                                    Foreground="White"
                                    Background="#416a9e"
                                    BorderBrush="#00aeff"/>

							<Button Content="Угол 3"
                                    Tag="CornerRightUp"
                                    Click="TileButton_Click"
                                    Margin="3"
                                    Foreground="White"
                                    Background="#416a9e"
                                    BorderBrush="#00aeff"/>

							<Button Content="Угол 4"
                                    Tag="CornerLeftUp"
                                    Click="TileButton_Click"
                                    Margin="3"
                                    Foreground="White"
                                    Background="#416a9e"
                                    BorderBrush="#00aeff"/>

							<Button Content="Т-сверху"
                                    Tag="TUp"
                                    Click="TileButton_Click"
                                    Margin="3"
                                    Foreground="White"
                                    Background="#416a9e"
                                    BorderBrush="#00aeff"/>

							<Button Content="Т-снизу"
                                    Tag="TDown"
                                    Click="TileButton_Click"
                                    Margin="3"
                                    Foreground="White"
                                    Background="#416a9e"
                                    BorderBrush="#00aeff"/>

							<Button Content="Перекресток"
                                    Tag="Cross"
                                    Click="TileButton_Click"
                                    Margin="3"
                                    Foreground="White"
                                    Background="#416a9e"
                                    BorderBrush="#00aeff"/>
						</UniformGrid>

						<TextBlock Text="ЛКМ по карте - поставить выбранный элемент. F1 - справка."
                                   Foreground="White"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,18,0,0"/>

					</StackPanel>
				</ScrollViewer>
			</Border>

			<Border Grid.Column="1"
                    Background="#111118"
                    Padding="18"
                    BorderBrush="#2d0054"
                    BorderThickness="4">

				<ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

					<Canvas x:Name="MapCanvas"
                            Background="#111118"
                            MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                            MouseMove="MapCanvas_MouseMove"/>
				</ScrollViewer>
			</Border>
		</Grid>
	</Grid>
</Window>
