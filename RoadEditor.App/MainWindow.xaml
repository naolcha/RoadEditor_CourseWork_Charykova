<Window x:Class="RoadEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Road Editor"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#111118"
        PreviewKeyDown="Window_PreviewKeyDown"
        Focusable="True">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="34"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Menu Grid.Row="0"
              Background="#15151D"
              Foreground="White"
              FontSize="14">

			<MenuItem Header="Очистить"
                      Click="ClearMap_Click"/>

			<MenuItem Header="Залить"
                      Click="FillMap_Click"/>

			<MenuItem Header="Сохранить"
                      Click="SaveMap_Click"/>

			<MenuItem Header="Загрузить"
                      Click="LoadMap_Click"/>

			<MenuItem Header="Экспорт PNG"
                      Click="ExportPng_Click"/>

			<MenuItem Header="Справка"
                      Click="Help_Click"/>
		</Menu>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="340"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0"
                    Background="#2D0054"
                    Padding="14">

				<ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

					<StackPanel>

						<TextBlock Text="Редактор дорог"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,0,0,18"/>

						<TextBlock x:Name="CellInfoText"
                                   Text="Номер ячейки: 0, 0"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,18"/>

						<TextBlock Text="Размер карты"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

						<Grid Margin="0,0,0,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0"
                                        Margin="0,0,6,0">

								<TextBlock Text="Ширина"
                                           Foreground="White"/>

								<TextBox x:Name="MapWidthTextBox"
                                         Text="12"
                                         Height="30"
                                         FontSize="16"/>
							</StackPanel>

							<StackPanel Grid.Column="1"
                                        Margin="6,0,0,0">

								<TextBlock Text="Высота"
                                           Foreground="White"/>

								<TextBox x:Name="MapHeightTextBox"
                                         Text="7"
                                         Height="30"
                                         FontSize="16"/>
							</StackPanel>
						</Grid>

						<Button Content="Создать карту"
                                Height="36"
                                FontSize="15"
                                Foreground="White"
                                Background="#416A9E"
                                BorderBrush="#00AEFF"
                                BorderThickness="1.5"
                                Margin="0,0,0,18"
                                Click="CreateMap_Click"/>

						<TextBlock Text="Текущий элемент"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

						<Border Width="132"
                                Height="132"
                                HorizontalAlignment="Center"
                                Background="#111118"
                                BorderBrush="#00AEFF"
                                BorderThickness="2"
                                Margin="0,0,0,12">

							<Canvas x:Name="SelectedTilePreview"
                                    Width="120"
                                    Height="120"
                                    Background="#111118"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
						</Border>

						<TextBlock x:Name="SelectedTileNameText"
                                   Text="Горизонтальная дорога"
                                   Foreground="White"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

						<Button Content="Залить карту"
                                Width="160"
                                Height="38"
                                HorizontalAlignment="Center"
                                FontSize="17"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#202530"
                                BorderBrush="#00AEFF"
                                BorderThickness="2"
                                Margin="0,0,0,20"
                                Click="FillMap_Click"/>

						<TextBlock Text="Доступные элементы"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

						<Border Width="296"
                                Height="224"
                                HorizontalAlignment="Center"
                                Background="#111118"
                                BorderBrush="#6A6A72"
                                BorderThickness="1">

							<Canvas x:Name="PaletteCanvas"
                                    Width="288"
                                    Height="216"
                                    Background="#111118"
                                    MouseLeftButtonDown="PaletteCanvas_MouseLeftButtonDown"/>
						</Border>

						<TextBlock Text="Нажми на элемент в палитре, затем нажми на нужную ячейку карты."
                                   Foreground="White"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0"/>

					</StackPanel>
				</ScrollViewer>
			</Border>

			<Border Grid.Column="1"
                    Background="#111118"
                    Padding="18"
                    BorderBrush="#2D0054"
                    BorderThickness="4">

				<ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

					<Canvas x:Name="MapCanvas"
                            Background="#111118"
                            MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                            MouseMove="MapCanvas_MouseMove"/>
				</ScrollViewer>
			</Border>
		</Grid>
	</Grid>
</Window>











