<Window x:Class="RoadEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Road Editor"
        Width="1280"
        Height="800"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#111118"
        PreviewKeyDown="Window_PreviewKeyDown"
        Focusable="True">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="34"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Menu Grid.Row="0"
              Background="#15151D"
              Foreground="White"
              FontSize="14">

			<MenuItem Header="Отмена"
                      Click="Undo_Click"/>

			<MenuItem Header="Повтор"
                      Click="Redo_Click"/>

			<Separator/>

			<MenuItem Header="Очистить карту"
                      Click="ClearMap_Click"/>

			<MenuItem Header="Загрузить"
                      Click="LoadMap_Click"/>

			<MenuItem Header="Сохранить"
                      Click="SaveMap_Click"/>

			<MenuItem Header="Экспорт PNG"
                      Click="ExportPng_Click"/>

			<Separator/>

			<MenuItem Header="Справка"
                      Click="Help_Click"/>
		</Menu>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="370"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0"
                    Background="#2D0054"
                    Padding="14">

				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>

						<TextBlock x:Name="CellInfoText"
                                   Text="Номер ячейки: 0, 0"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,14"/>

						<TextBlock Text="Размер карты"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0"
                                        Margin="0,0,6,0">

								<TextBlock Text="Ширина"
                                           Foreground="White"/>

								<TextBox x:Name="MapWidthTextBox"
                                         Text="12"
                                         Height="30"
                                         FontSize="16"/>
							</StackPanel>

							<StackPanel Grid.Column="1"
                                        Margin="6,0,0,0">

								<TextBlock Text="Высота"
                                           Foreground="White"/>

								<TextBox x:Name="MapHeightTextBox"
                                         Text="7"
                                         Height="30"
                                         FontSize="16"/>
							</StackPanel>
						</Grid>

						<Button Content="Создать карту"
                                Height="34"
                                FontSize="15"
                                Foreground="White"
                                Background="#416A9E"
                                BorderBrush="#00AEFF"
                                BorderThickness="1.5"
                                Margin="0,0,0,14"
                                Click="CreateMap_Click"/>

						<TextBlock Text="Режим работы"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

						<UniformGrid Columns="2"
                                     Margin="0,0,0,8">

							<Button Content="Дороги"
                                    Tag="Road"
                                    Height="32"
                                    Margin="2"
                                    Click="DrawingTool_Click"/>

							<Button Content="Выбор"
                                    Tag="Select"
                                    Height="32"
                                    Margin="2"
                                    Click="DrawingTool_Click"/>

							<Button Content="Линия"
                                    Tag="Line"
                                    Height="32"
                                    Margin="2"
                                    Click="DrawingTool_Click"/>

							<Button Content="Прямоугольник"
                                    Tag="Rectangle"
                                    Height="32"
                                    Margin="2"
                                    Click="DrawingTool_Click"/>

							<Button Content="Эллипс"
                                    Tag="Ellipse"
                                    Height="32"
                                    Margin="2"
                                    Click="DrawingTool_Click"/>

							<Button Content="Треугольник"
                                    Tag="Triangle"
                                    Height="32"
                                    Margin="2"
                                    Click="DrawingTool_Click"/>

							<Button Content="Стрелка"
                                    Tag="Arrow"
                                    Height="32"
                                    Margin="2"
                                    Click="DrawingTool_Click"/>

							<Button Content="Звезда"
                                    Tag="Star"
                                    Height="32"
                                    Margin="2"
                                    Click="DrawingTool_Click"/>
						</UniformGrid>

						<TextBlock x:Name="DrawingModeText"
                                   Text="Режим: размещение дорог"
                                   Foreground="#8DD7FF"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>

						<TextBlock Text="Цвет контура"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>

						<ComboBox x:Name="StrokeColorComboBox"
                                  SelectedIndex="0"
                                  Height="30"
                                  Margin="0,0,0,8">

							<ComboBoxItem Content="Белый"
                                          Tag="#FFFFFF"/>

							<ComboBoxItem Content="Черный"
                                          Tag="#111111"/>

							<ComboBoxItem Content="Красный"
                                          Tag="#E53935"/>

							<ComboBoxItem Content="Синий"
                                          Tag="#1E88E5"/>

							<ComboBoxItem Content="Зеленый"
                                          Tag="#43A047"/>

							<ComboBoxItem Content="Желтый"
                                          Tag="#FDD835"/>

							<ComboBoxItem Content="Фиолетовый"
                                          Tag="#8E24AA"/>
						</ComboBox>

						<TextBlock Text="Цвет заливки"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>

						<ComboBox x:Name="FillColorComboBox"
                                  SelectedIndex="2"
                                  Height="30"
                                  Margin="0,0,0,6">

							<ComboBoxItem Content="Белый"
                                          Tag="#FFFFFF"/>

							<ComboBoxItem Content="Черный"
                                          Tag="#111111"/>

							<ComboBoxItem Content="Красный"
                                          Tag="#E53935"/>

							<ComboBoxItem Content="Синий"
                                          Tag="#1E88E5"/>

							<ComboBoxItem Content="Зеленый"
                                          Tag="#43A047"/>

							<ComboBoxItem Content="Желтый"
                                          Tag="#FDD835"/>

							<ComboBoxItem Content="Фиолетовый"
                                          Tag="#8E24AA"/>
						</ComboBox>

						<CheckBox x:Name="UseFillCheckBox"
                                  Content="Использовать заливку"
                                  IsChecked="True"
                                  Foreground="White"
                                  Margin="0,0,0,8"/>

						<Grid Margin="0,0,0,14">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Button Grid.Column="0"
                                    Content="Удалить фигуру"
                                    Height="32"
                                    Margin="0,0,4,0"
                                    Click="DeleteSelectedShape_Click"/>

							<Button Grid.Column="1"
                                    Content="Очистить фигуры"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Click="ClearShapes_Click"/>
						</Grid>

						<TextBlock x:Name="SelectedShapeText"
                                   Text="Фигура не выбрана"
                                   Foreground="#D9CBE7"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   Margin="0,0,0,14"/>

						<TextBlock Text="Текущий дорожный элемент"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

						<Canvas x:Name="SelectedTilePreview"
                                Width="110"
                                Height="110"
                                Background="#111118"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,8"/>

						<TextBlock x:Name="SelectedTileNameText"
                                   Text="Горизонтальная дорога"
                                   Foreground="White"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

						<Button Content="Заливка карты"
                                Height="34"
                                FontSize="15"
                                Foreground="White"
                                Background="#202530"
                                BorderBrush="#00AEFF"
                                BorderThickness="1.5"
                                Margin="0,0,0,14"
                                Click="FillMap_Click"/>

						<TextBlock Text="Масштаб и перемещение"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,7"/>

						<Grid Margin="0,0,0,6">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Button Grid.Column="0"
                                    Content="−"
                                    Height="32"
                                    Margin="0,0,4,0"
                                    FontSize="18"
                                    Click="ZoomOut_Click"/>

							<Button Grid.Column="1"
                                    Content="100%"
                                    Height="32"
                                    Margin="2,0"
                                    Click="ResetZoom_Click"/>

							<Button Grid.Column="2"
                                    Content="+"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    FontSize="18"
                                    Click="ZoomIn_Click"/>
						</Grid>

						<TextBlock x:Name="ZoomInfoText"
                                   Text="Масштаб: 100%"
                                   Foreground="White"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>

						<TextBlock Text="Колесо мыши меняет масштаб. Правая кнопка мыши перемещает карту."
                                   Foreground="#D9CBE7"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,14"/>

						<TextBlock Text="Дорожные элементы"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

						<Canvas x:Name="PaletteCanvas"
                                Width="288"
                                Height="216"
                                Background="#111118"
                                HorizontalAlignment="Center"
                                MouseLeftButtonDown="PaletteCanvas_MouseLeftButtonDown"/>
					</StackPanel>
				</ScrollViewer>
			</Border>

			<Border Grid.Column="1"
                    Background="#111118"
                    Padding="18"
                    BorderBrush="#2D0054"
                    BorderThickness="4">

				<ScrollViewer x:Name="MapScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel"
                              PreviewMouseRightButtonDown="MapScrollViewer_PreviewMouseRightButtonDown"
                              PreviewMouseRightButtonUp="MapScrollViewer_PreviewMouseRightButtonUp"
                              PreviewMouseMove="MapScrollViewer_PreviewMouseMove">

					<Grid x:Name="MapHost"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">

						<Grid.LayoutTransform>
							<ScaleTransform x:Name="MapScaleTransform"
                                            ScaleX="1"
                                            ScaleY="1"/>
						</Grid.LayoutTransform>

						<Canvas x:Name="MapCanvas"
                                Background="#111118"
                                MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                                MouseMove="MapCanvas_MouseMove"/>

						<Canvas x:Name="DrawingCanvas"
                                Width="{Binding ElementName=MapCanvas, Path=Width}"
                                Height="{Binding ElementName=MapCanvas, Path=Height}"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                                MouseMove="DrawingCanvas_MouseMove"
                                MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp"/>
					</Grid>
				</ScrollViewer>
			</Border>
		</Grid>
	</Grid>
</Window>